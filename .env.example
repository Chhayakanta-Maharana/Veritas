# ==============================================================================
# DOOMSDAY SENTINEL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure your production or local values.
# Do NOT commit sensitive credentials or real secrets to version control.
# ==============================================================================

# Database Configuration (Neon Serverless PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Django Security and Application Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-64-character-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model Artifact and Storage Paths
MODEL_ARTIFACT_PATH=artifacts/model/best_model.pth
MODEL_METADATA_PATH=artifacts/metadata/model_metadata.json
MEDIA_ROOT=backend/media
MAX_UPLOAD_SIZE=52428800  # 50 MB in bytes

# Frontend Public API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
